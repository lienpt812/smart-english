# Backend (chạy local: trỏ tới postgres/redis trên Docker hoặc localhost)
# Base URL hiển thị trong Swagger ("Try it out"); mặc định http://localhost:PORT
# API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgresql://smartenglish:smartenglish@localhost:5432/smartenglish
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3000

# AI Service rieng (local dev)
AI_SERVICE_URL=http://localhost:4200
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key

# Auth Phase 1 — Google OAuth (Web client ID cho verify ID token GIS)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# JWT (đặt chuỗi ngẫu nhiên dài ≥16 ký tự trong production)
JWT_SECRET=change-me-dev-secret-min-16chars
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_DAYS=30

# Frontend Vite
VITE_BACKEND_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Legacy Next.js names kept only for old local scripts that may still read them.
# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase (M1 + M2) — project URL và anon key từ Supabase Dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
